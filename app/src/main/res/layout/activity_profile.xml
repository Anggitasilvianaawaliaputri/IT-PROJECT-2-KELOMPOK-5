<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ProfileActivity">

    <!-- Konten Scrollable -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tombol Kembali -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:background="@drawable/rounded_button_gray"
                android:src="@drawable/ic_back"
                android:contentDescription="Kembali"
                android:elevation="4dp" />

            <!-- Judul -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profil Pengelola"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="-16dp"
                android:textColor="#000000" />

            <!-- Avatar -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_user_avatar"
                android:contentDescription="Foto Profil"
                android:background="@drawable/circle_background"
                android:layout_centerHorizontal="true"
                android:elevation="4dp" />

            <!-- Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Nama -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#000000" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_input_gray"
                    android:padding="10dp"
                    android:text="Andika Putra"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#000000" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_input_gray"
                    android:padding="10dp"
                    android:text="AndikaPutra@gmail.com"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="16dp" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#000000" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_input_gray"
                    android:padding="10dp"
                    android:text="******"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:inputType="textPassword" />
            </LinearLayout>

            <!-- Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="Logout"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/rounded_green_button" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#1B5E20"
        android:gravity="center"
        android:weightSum="4"
        android:paddingHorizontal="8dp"
        android:elevation="8dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_leaf"
            android:padding="10dp"
            android:contentDescription="Nav Leaf" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_calendar"
            android:padding="10dp"
            android:contentDescription="Nav Calendar" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_bell"
            android:padding="10dp"
            android:contentDescription="Nav Bell" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_user"
            android:padding="10dp"
            android:contentDescription="Nav User" />
    </LinearLayout>
</RelativeLayout>
